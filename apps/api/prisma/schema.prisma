generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id             String   @id @default(uuid())
  name           String
  repoUrl        String
  detectedStack  Json?
  status         String   @default("detected")
  createdAt      DateTime @default(now())
}
