generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id               String   @id @default(uuid())
  name             String
  repoUrl          String
  detectedStack    String?
  status           String   @default("detected")
  assignedPort     Int?
  containerName    String?
  terminalEnabled  Boolean  @default(true)
  databaseEnabled  Boolean  @default(true)
  customDomain     String?  @unique
  domainSslStatus  String   @default("none")
  autoDeployEnabled Boolean @default(false)
  deployBranch     String   @default("main")
  createdAt        DateTime @default(now())
  envVars          EnvVar[]
  managedDatabase  ManagedDatabase?
  cronJobs         CronJob[]
  deployRecords    DeployRecord[]
}

model DeployRecord {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String
  triggeredBy  String
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
}

model CronJob {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  command    String
  schedule   String
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  lastStatus String?
  lastOutput String?
  createdAt  DateTime  @default(now())
}

model ManagedDatabase {
  id               String   @id @default(uuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             String
  username         String?
  password         String?
  databaseName     String?
  connectionString String?
  envVarKey        String?
  persistent       Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model EnvVar {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())

  @@unique([projectId, key])
}

model GithubInstallation {
  id             String   @id @default(uuid())
  installationId Int      @unique
  accountLogin   String
  createdAt      DateTime @default(now())
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String
  twoFactorSecret      String?
  twoFactorEnabled     Boolean        @default(false)
  twoFactorBackupCodes String?
  createdAt            DateTime       @default(now())
  refreshTokens        RefreshToken[]
}

model MetricSample {
  id              String   @id @default(uuid())
  cpuPercent      Float
  usedMemPercent  Float
  usedDiskPercent Float
  capturedAt      DateTime @default(now())

  @@index([capturedAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
}
