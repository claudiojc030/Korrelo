generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id               String   @id @default(uuid())
  name             String
  repoUrl          String
  detectedStack    String?
  status           String   @default("detected")
  assignedPort     Int?
  containerName    String?
  terminalEnabled  Boolean  @default(true)
  databaseEnabled  Boolean  @default(true)
  customDomain     String?  @unique
  domainSslStatus  String   @default("none")
  autoDeployEnabled Boolean @default(false)
  deployBranch     String   @default("main")
  diskLimitMb      Int?
  skipStagingTest  Boolean  @default(false)
  memoryLimitMb    Int?
  // Estado do ÚLTIMO deploy (queued/running/succeeded/failed/rolled-back).
  // Separado de "status" (que é o estado de RUNTIME da aplicação): um deploy
  // de staging falho não significa que a aplicação em produção caiu.
  lastDeployStatus String?
  // Imagem em produção (tag por commit) e imagem anterior, usadas no
  // rollback automático quando a nova versão falha na promoção.
  currentImage     String?
  previousImage    String?
  // Healthcheck Docker do container (JSON serializado). Null = sem
  // healthcheck (comportamento padrão e conservador).
  healthcheckConfig String?
  // --- Wave 2.1: grandfathering ---------------------------------------
  // Limite de memória do container de PRODUÇÃO observado no Docker
  // (fonte da verdade do runtime atual). NUNCA é reduzido automaticamente:
  // um projeto que já roda continua com o limite que tem.
  productionMemoryLimitMb Int?
  // Snapshot do runtime atual em JSON (limite, imagem, restart policy,
  // redes, portas, observedAt). Serve pra detectar divergência entre o Core
  // e o Docker e pra mostrar o que aconteceria num dry-run.
  runtimeSnapshot String?
  // true quando o projeto foi "adotado" sem passar por um deploy com a
  // política nova de memória (ou seja: o runtime atual é preservado).
  grandfathered Boolean @default(false)
  grandfatheredAt DateTime?
  // Divergência entre o que o Core registra e o que o Docker mostra.
  runtimeDriftDetected Boolean @default(false)
  runtimeDriftDetails String?
  // true quando o ADMIN autorizou explicitamente reduzir o limite de
  // memória de um projeto que está rodando (sem isso, a redução é ignorada
  // e o container continua com o limite atual).
  memoryLimitReductionApproved Boolean @default(false)
  createdAt        DateTime @default(now())
  envVars          EnvVar[]
  managedDatabases ManagedDatabase[]
  cronJobs         CronJob[]
  deployRecords    DeployRecord[]
  deployJobs       DeployJob[]
  domainAliases    ProjectDomainAlias[]
}

// Hostnames extras que servem o MESMO projeto (mesma porta), no mesmo
// certificado do domínio principal (ex.: www.exemplo.com apontando pro mesmo
// lugar que exemplo.com). Domínio principal continua em Project.customDomain -
// essa tabela só existe pros ALÉM do principal.
model ProjectDomainAlias {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain    String   @unique
  createdAt DateTime @default(now())
}

model DeployRecord {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String
  triggeredBy  String
  errorMessage String?
  log          String    @default("")
  commitHash   String?
  commitMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
}

// Fila global de deploy.
//
// Uma linha = UM deploy agendado. O worker da API pega sempre o job mais
// antigo com status "queued" e roda UM por vez na VPS inteira (concorrência
// global = 1): é o que impede dois builds simultâneos numa VPS de 1 vCPU.
//
// A unicidade lógica é (projectId, commitSha): o mesmo commit do mesmo
// projeto não vira dois jobs. Um job manual (commitSha desconhecido no
// momento do agendamento) tem commitSha NULL - e NULLs são distintos em
// índice único no SQLite, então vários jobs manuais convivem; a
// deduplicação de manuais é feita por projeto (um job em aberto por projeto).
model DeployJob {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitSha    String?
  branch       String
  trigger      String
  status       String    @default("queued")
  attempt      Int       @default(0)
  // Etapa atual do job (queued/fetching/building/staging-start/
  // staging-health/promote/production-health/rollback/cleanup/complete).
  stage        String?
  errorMessage String?
  log          String    @default("")
  // Imagem que estava em produção antes deste deploy e imagem candidata.
  previousImage   String?
  candidateImage  String?
  rollbackAttempted Boolean @default(false)
  rollbackSucceeded Boolean @default(false)
  // Tag da imagem gerada por este deploy (versionada por commit).
  imageTag     String?
  // Duração do build (ms) e do deploy inteiro (ms) - métricas internas.
  buildDurationMs Int?
  deployDurationMs Int?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@unique([projectId, commitSha])
  @@index([status, createdAt])
}

model CronJob {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  command    String
  schedule   String
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  lastStatus String?
  lastOutput String?
  createdAt  DateTime  @default(now())
}

// Um projeto pode ter mais de um banco gerenciado (ex.: Postgres + Redis pro
// mesmo app) - por isso @@unique é composto (projeto, tipo) em vez de único
// por projeto. serviceName é o nome do serviço/host no docker-compose: o
// primeiro banco de um projeto sempre fica "db" (compatibilidade com todo
// projeto existente antes disso existir), qualquer banco adicional ganha
// "db-<tipo>" pra não colidir.
model ManagedDatabase {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             String
  serviceName      String?
  username         String?
  password         String?
  databaseName     String?
  connectionString String?
  envVarKey        String?
  persistent       Boolean  @default(false)
  // Limite de memória observado do container deste banco (bytes -> MB na
  // aplicação). Preservado no grandfathering: nunca reduzido sozinho.
  memoryLimitMb    Int?
  createdAt        DateTime @default(now())

  @@unique([projectId, type])
}

model EnvVar {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())

  @@unique([projectId, key])
}

model GithubInstallation {
  id             String   @id @default(uuid())
  installationId Int      @unique
  accountLogin   String
  createdAt      DateTime @default(now())
}

model User {
  id                   String         @id @default(uuid())
  username             String         @unique
  passwordHash         String
  twoFactorSecret      String?
  twoFactorEnabled     Boolean        @default(false)
  twoFactorBackupCodes String?
  createdAt            DateTime       @default(now())
  refreshTokens        RefreshToken[]
}

model MetricSample {
  id              String   @id @default(uuid())
  cpuPercent      Float
  usedMemPercent  Float
  usedDiskPercent Float
  capturedAt      DateTime @default(now())

  @@index([capturedAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  // Hash do token que rotacionou este aqui. Permite um curto período de graça
  // pra pedidos concorrentes que ainda usam o token velho (ver
  // RefreshAccessTokenUseCase) sem precisar deslogar por causa de uma corrida.
  replacedByTokenHash String?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
}
