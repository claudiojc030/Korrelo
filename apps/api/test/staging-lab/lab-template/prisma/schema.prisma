// Schema MÍNIMO do laboratório: apenas as tabelas usadas pelo executor real.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(uuid())
  name          String
  repoUrl       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stagingRuns   StagingRun[]
  stagingLeases StagingPortLease[]
}

model StagingPortLease {
  id         String       @id @default(uuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId      String
  hostPort   Int
  portKey    String?      @unique
  status     String
  expiresAt  DateTime
  memoryMb   Int
  cpu        Float
  diskMb     Int
  ownerId    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  releasedAt DateTime?
  stagingRun StagingRun?

  @@unique([projectId, runId])
  @@index([status, expiresAt])
}

model StagingRun {
  id             String           @id @default(uuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployJobId    String?
  runId          String
  composeProject String
  status         String
  planHash       String
  composeHash    String
  imageReference String?
  imageId        String?
  imageDigest    String?
  memoryMb       Int
  cpu            Float
  diskMb         Int
  leaseId        String           @unique
  lease          StagingPortLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  networkName    String?
  volumePrefix   String?
  ownerId        String?
  cleanupState   String           @default("none")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  expiresAt      DateTime

  @@unique([projectId, runId])
  @@index([status, expiresAt])
}

model StagingCoordinator {
  id        String   @id
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}
