PORT=3001
# Dev local sem Docker: SQLite. Em produção/VPS real, trocar para Postgres:
# DATABASE_URL=postgresql://korrelo:korrelo@localhost:5432/korrelo
DATABASE_URL="file:./dev.db"
REDIS_URL=redis://localhost:6379

# GitHub App (ver instruções para cadastrar em github.com/settings/apps/new)
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# Cole o conteúdo do arquivo .pem inteiro numa linha só, com \n no lugar das quebras de linha
GITHUB_APP_PRIVATE_KEY=
# Segredo do Webhook (settings do GitHub App > Webhook secret), necessário
# pra deploy automático funcionar; configure o Webhook URL do App pra
# https://SEU_DOMINIO/api/github/webhook (ou http://SEU_IP:3001/github/webhook
# sem domínio ainda), com o evento "Push" habilitado.
GITHUB_APP_WEBHOOK_SECRET=
KORRELO_WEB_URL=http://localhost:3000
# Origens autorizadas a mandar cookie de login (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

# Autenticação: gere um valor aleatório, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Cifra as variáveis de ambiente de cada projeto em repouso (AES-256-GCM).
# 32 bytes em hex, gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENV_ENCRYPTION_KEY=

# --- Backup (opcional, ver scripts/backup.sh) ---
# BACKUP_DIR=
# BACKUP_RETENTION_DAYS=
# Tópico do ntfy.sh pra receber um push se o backup diário falhar.
# BACKUP_ALERT_NTFY_TOPIC=
# Nome de um remote configurado via `rclone config` (ex: Google Drive) pra
# copiar os backups pra fora da VPS.
# BACKUP_RCLONE_REMOTE=

# --- Orçamento de memória (Wave 2) -------------------------------------
# A memória da VPS é dividida entre o host, o Core (API+web), o Docker e
# os projetos. App, banco e container de teste dividem a MESMA fatia - nunca
# é "a RAM inteira pro app" mais o banco por fora.
# KORRELO_MEM_HOST_RESERVE_MB=512
# KORRELO_MEM_CORE_RESERVE_MB=640
# KORRELO_MEM_DOCKER_RESERVE_MB=256
# KORRELO_MEM_SAFETY_MARGIN_MB=256
# KORRELO_MEM_MAX_CONTAINER_MB=1024
# KORRELO_MEM_MIN_CONTAINER_MB=128
# Fração da fatia do projeto reservada pro banco e pro container de teste.
# KORRELO_MEM_DB_SHARE=0.35
# KORRELO_MEM_STAGING_SHARE=0.25
# Fração do limite do container que o heap do Node (V8) pode usar.
# KORRELO_NODE_HEAP_RATIO=0.7

# --- Pré-condições de build (Wave 2) ------------------------------------
# Memória livre (MB) e disco livre (MB) exigidos ANTES de começar um build.
# Sem folga, o deploy volta pra fila em vez de derrubar a VPS.
# KORRELO_BUILD_MEMORY_REQUIREMENT_MB=1024
# KORRELO_BUILD_DISK_REQUIREMENT_MB=2000

# --- Swap dos containers (opcional, desligado por padrão) ---------------
# Sem este valor, o comportamento é o padrão do Docker: com mem_limit
# definido e sem memswap_limit, o container pode usar swap até o DOBRO do
# mem_limit. Definir o valor IGUAL ao mem_limit do container proíbe swap
# nele (o container morre por OOM em vez de fazer swap). Meça antes.
# KORRELO_MEMSWAP_LIMIT_MB=
