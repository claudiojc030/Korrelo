PORT=3001
# Dev local sem Docker: SQLite. Em produção/VPS real, trocar para Postgres:
# DATABASE_URL=postgresql://forgedesk:forgedesk@localhost:5432/forgedesk
DATABASE_URL="file:./dev.db"
REDIS_URL=redis://localhost:6379

# GitHub App (ver instruções para cadastrar em github.com/settings/apps/new)
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# Cole o conteúdo do arquivo .pem inteiro numa linha só, com \n no lugar das quebras de linha
GITHUB_APP_PRIVATE_KEY=
# Segredo do Webhook (settings do GitHub App > Webhook secret) — necessário
# pra deploy automático funcionar; configure o Webhook URL do App pra
# https://SEU_DOMINIO/api/github/webhook (ou http://SEU_IP:3001/github/webhook
# sem domínio ainda), com o evento "Push" habilitado.
GITHUB_APP_WEBHOOK_SECRET=
FORGEDESK_WEB_URL=http://localhost:3000
# Origens autorizadas a mandar cookie de login (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

# Autenticação — gere um valor aleatório, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Cifra as variáveis de ambiente de cada projeto em repouso (AES-256-GCM).
# 32 bytes em hex — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENV_ENCRYPTION_KEY=

# --- Backup (opcional, ver scripts/backup.sh) ---
# BACKUP_DIR=
# BACKUP_RETENTION_DAYS=
# Tópico do ntfy.sh pra receber um push se o backup diário falhar.
# BACKUP_ALERT_NTFY_TOPIC=
# Nome de um remote configurado via `rclone config` (ex: Google Drive) pra
# copiar os backups pra fora da VPS.
# BACKUP_RCLONE_REMOTE=
